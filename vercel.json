{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "rewrites": [
        {
            "source": "/build/:path*",
            "destination": "/public/build/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ]
}